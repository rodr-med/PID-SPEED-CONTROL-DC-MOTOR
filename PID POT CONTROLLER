const int potPin = 34;   // Entrada analógica del potenciómetro
const int enaPin = 18;   // Pin ENA del L298N (PWM)
const int in1Pin = 19;   // IN1 del L298N
const int in2Pin = 21;   // IN2 del L298N

const int pwmFreq = 10000; 
const int pwmRes = 8;     

void setup() {
  Serial.begin(115200);

  pinMode(in1Pin, OUTPUT);
  pinMode(in2Pin, OUTPUT);

  ledcAttach(enaPin, pwmFreq, pwmRes);
}

void loop() {
  int potValue = analogRead(potPin); 
  if (potValue > 250) {
    digitalWrite(in1Pin, HIGH);
    digitalWrite(in2Pin, LOW);
    
    int speed = map(potValue, 100, 4095, 0, 250);
    ledcWrite(enaPin, speed); 
  } else {

    digitalWrite(in1Pin, LOW);
    digitalWrite(in2Pin, LOW);
    ledcWrite(enaPin, 0);
  }

  delay(20);
}
